    "culori": "^4.0.2",
    "hover-tilt": "^1.0.0",
    "html2canvas": "^1.4.1",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "psn-api": "^2.18.1",
